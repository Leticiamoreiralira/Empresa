    {
      "cell_type": "code",
      "source": [
        "# Gerar previsões dos modelos base na validação\n",
        "val_predictions = []\n",
        "\n",
        "for name, model in base_models.items():\n",
        "\n",
        "    pred = model.predict(X_val_scaled)\n",
        "\n",
        "    val_predictions.append(pred)\n",
        "\n",
        "# Criar meta-features\n",
        "X_meta_train = np.column_stack(val_predictions)\n",
        "\n",
        "# Treinar meta-modelo\n",
        "blending_meta = RandomForestClassifier(\n",
        "    n_estimators=100,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "blending_meta.fit(X_meta_train, y_val)\n",
        "\n",
        "# Gerar previsões dos modelos base no teste\n",
        "test_predictions = []\n",
        "\n",
        "for name, model in base_models.items():\n",
        "\n",
        "    pred = model.predict(X_test_scaled)\n",
        "\n",
        "    test_predictions.append(pred)\n",
        "\n",
        "X_meta_test = np.column_stack(test_predictions)\n",
        "\n",
        "# Previsão final\n",
        "blending_pred = blending_meta.predict(X_meta_test)\n",
        "\n",
        "blending_acc = accuracy_score(\n",
        "    y_test,\n",
        "    blending_pred\n",
        ")\n",
        "\n",
        "print(\"🎯 BLENDING ENSEMBLE\")\n",
        "print(f\"Accuracy no teste: {blending_acc:.4f}\")"
      ],
