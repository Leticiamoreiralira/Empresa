    {
      "cell_type": "code",
      "source": [
        "# Criar modelos base\n",
        "base_models = {\n",
        "    'Logistic Regression': LogisticRegression(random_state=42),\n",
        "    'Decision Tree': DecisionTreeClassifier(random_state=42),\n",
        "    'SVM': SVC(probability=True, random_state=42),\n",
        "    'KNN': KNeighborsClassifier(n_neighbors=5)\n",
        "}\n",
        "\n",
        "# Treinar e avaliar modelos base\n",
        "base_results = {}\n",
        "\n",
        "print(\"🤖 TREINANDO MODELOS BASE:\\n\")\n",
        "\n",
        "for name, model in base_models.items():\n",
        "\n",
        "    model.fit(X_train_scaled, y_train)\n",
        "\n",
        "    val_pred = model.predict(X_val_scaled)\n",
        "\n",
        "    val_acc = accuracy_score(y_val, val_pred)\n",
        "\n",
        "    base_results[name] = {\n",
        "        'model': model,\n",
        "        'val_accuracy': val_acc\n",
        "    }\n",
        "\n",
        "    print(f\"{name}:\")\n",
        "    print(f\"Validação Accuracy = {val_acc:.4f}\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "# Melhor modelo base\n",
        "best_base = max(base_results.items(),\n",
        "                key=lambda x: x[1]['val_accuracy'])\n",
        "\n",
        "print(f\"\\n🏆 Melhor Modelo Base:\")\n",
        "print(f\"{best_base[0]} - Accuracy: {best_base[1]['val_accuracy']:.4f}\")"
      ],
