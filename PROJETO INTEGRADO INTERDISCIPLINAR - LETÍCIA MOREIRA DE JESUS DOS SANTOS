    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# 3. FEATURE ENGINEERING (Data Mining)\n",
        "# ============================================================\n",
        "\n",
        "df = df.merge(gastos, on=\"id_cliente\")\n",
        "\n",
        "df[\"num_compras\"] = df.groupby(\"id_cliente\")[\"id_venda\"].transform(\"count\")\n",
        "\n",
        "df[\"ticket_medio\"] = df[\"gasto_total\"] / df[\"num_compras\"]"
      ],
      "metadata": {
        "id": "HYhOP5NHg6WN"
      },
